# Put this next to your project (or in ~/.ssh/config) and reference it as hosts.workers[].sshConfig.
# Two aliases per server: root for setup, the developer user for everything else.
Host workhorse workhorse-root
  HostName 100.64.0.0              # the server's Tailscale IP (never its public address)
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  UserKnownHostsFile ~/.ssh/known_hosts_workhorse
  BatchMode yes
  ServerAliveInterval 30
Host workhorse-root
  User root
Host workhorse
  User developer
